<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>波段股票分析系统 v4.0</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Microsoft YaHei', Arial, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 20px;
            color: #fff;
        }
        .container { max-width: 1800px; margin: 0 auto; }
        
        /* 头部 */
        .header {
            text-align: center;
            margin-bottom: 20px;
            padding: 15px;
            background: rgba(255,255,255,0.1);
            border-radius: 15px;
        }
        .header h1 { font-size: 26px; margin-bottom: 8px; }
        .header .time-info { font-size: 13px; color: #888; }
        
        .btn {
            padding: 10px 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 20px;
            color: white;
            cursor: pointer;
            margin: 5px;
            font-size: 14px;
            transition: all 0.3s;
        }
        .btn:hover { transform: scale(1.05); opacity: 0.9; }
        .btn-sm { padding: 5px 12px; font-size: 12px; }
        .btn-danger { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
        .btn-success { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
        .btn-info { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); }
        
        /* 持仓录入面板 */
        .input-panel {
            background: rgba(102, 126, 234, 0.15);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid rgba(102, 126, 234, 0.3);
        }
        .input-header { font-size: 16px; font-weight: bold; margin-bottom: 12px; color: #667eea; }
        
        .input-form {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr auto;
            gap: 10px;
            align-items: end;
        }
        .input-group { display: flex; flex-direction: column; }
        .input-label { font-size: 11px; color: #888; margin-bottom: 4px; }
        
        .input-field, select.input-field {
            padding: 8px 10px;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 6px;
            color: #fff;
            font-size: 13px;
            min-height: 32px;
        }
        .input-field:focus { outline: none; border-color: #667eea; }
        
        /* 下拉列表样式修复 */
        select.input-field option {
            background: #1a1a2e;
            color: #fff;
            padding: 8px;
        }
        
        /* 持仓列表 */
        .holdings-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 12px;
            margin-top: 15px;
        }
        
        .holding-card {
            background: rgba(255,255,255,0.08);
            border-radius: 10px;
            padding: 12px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .holding-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .holding-name { font-size: 14px; font-weight: bold; }
        
        .holding-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            font-size: 12px;
        }
        .detail-item { background: rgba(0,0,0,0.15); padding: 6px 8px; border-radius: 4px; }
        .detail-label { color: #888; font-size: 10px; }
        .detail-value { color: #fff; font-size: 12px; }
        
        .holding-advice {
            margin-top: 10px;
            padding: 8px;
            background: rgba(0,0,0,0.2);
            border-radius: 6px;
            font-size: 12px;
            border-left: 3px solid #6366f1;
        }
        
        /* 统计面板 */
        .stats-panel {
            background: rgba(102, 126, 234, 0.1);
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
        }
        .stat-item { text-align: center; }
        .stat-value { font-size: 20px; font-weight: bold; color: #10b981; }
        .stat-value.negative { color: #ef4444; }
        .stat-label { font-size: 10px; color: #888; }
        
        /* 四栏分析面板 */
        .analysis-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 15px;
            margin-bottom: 15px;
        }
        
        .panel {
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 15px;
            min-height: 300px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        .panel-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid rgba(255,255,255,0.1);
        }
        .panel-title { font-size: 15px; font-weight: bold; }
        .panel-count {
            font-size: 11px;
            color: #888;
            padding: 4px 10px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
        }
        
        .stock-list { max-height: 250px; overflow-y: auto; }
        
        /* 股票卡片 */
        .stock-card {
            background: rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 8px;
            transition: all 0.2s;
        }
        .stock-card:hover { background: rgba(255,255,255,0.12); }
        
        .stock-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .stock-name { font-size: 13px; font-weight: bold; }
        .stock-code { font-size: 11px; color: #888; margin-left: 5px; }
        
        .stock-score {
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 13px;
        }
        .score-high { background: #10b981; color: #fff; }
        .score-medium { background: #f59e0b; color: #fff; }
        .score-low { background: #ef4444; color: #fff; }
        .score-hold { background: #6366f1; color: #fff; }
        
        .stock-info {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #888;
            margin-bottom: 6px;
        }
        
        .stock-price-info {
            display: flex;
            gap: 10px;
            font-size: 11px;
            margin-bottom: 6px;
        }
        .price-item { color: #aaa; }
        .price-buy { color: #10b981; }
        .price-sell { color: #ef4444; }
        
        .stock-advice {
            font-size: 12px;
            padding: 6px 8px;
            background: rgba(0,0,0,0.2);
            border-radius: 4px;
            margin-top: 6px;
        }
        .advice-buy { color: #10b981; border-left: 3px solid #10b981; padding-left: 10px; }
        .advice-sell { color: #ef4444; border-left: 3px solid #ef4444; padding-left: 10px; }
        .advice-hold { color: #6366f1; border-left: 3px solid #6366f1; padding-left: 10px; }
        .advice-watch { color: #f59e0b; border-left: 3px solid #f59e0b; padding-left: 10px; }
        
        .stock-actions {
            display: flex;
            gap: 5px;
            margin-top: 8px;
        }
        
        /* 大盘信息面板 */
        .market-panel {
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 15px;
            margin-top: 15px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .market-header { font-size: 15px; font-weight: bold; margin-bottom: 12px; color: #667eea; }
        .market-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }
        .market-card {
            background: rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 12px;
            text-align: center;
        }
        .market-card-label { font-size: 12px; color: #888; margin-bottom: 6px; }
        .market-card-value { font-size: 18px; font-weight: bold; }
        .market-strong { color: #10b981; }
        .market-weak { color: #ef4444; }
        .market-neutral { color: #667eea; }
        .market-chart {
            background: rgba(0,0,0,0.2);
            border-radius: 8px;
            padding: 12px;
            margin-top: 12px;
        }
        .market-chart-title { font-size: 13px; color: #888; margin-bottom: 8px; }
        .market-chart-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 11px;
        }
        .market-chart-date { color: #888; }
        .market-chart-close { color: #fff; }
        .market-chart-pct { }
        .market-adjust-examples {
            margin-top: 15px;
            padding: 12px;
            background: rgba(0,0,0,0.2);
            border-radius: 8px;
        }
        .market-adjust-title { font-size: 13px; color: #667eea; margin-bottom: 8px; }
        .market-adjust-row { font-size: 11px; color: #aaa; padding: 3px 0; }
        
        /* 弹窗 */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .modal.show { display: flex; }
        .modal-content {
            background: #1a1a2e;
            border-radius: 15px;
            padding: 20px;
            max-width: 500px;
            width: 90%;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .modal-header { font-size: 18px; font-weight: bold; margin-bottom: 15px; }
        .modal-body { font-size: 13px; line-height: 1.6; }
        .modal-close {
            position: absolute;
            top: 10px; right: 15px;
            font-size: 20px;
            cursor: pointer;
            color: #888;
        }
        
        /* 滚动条 */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }
    </style>
</head>
<body>
    <div class="container">
        <!-- 头部 -->
        <div class="header">
            <h1>📊 波段股票分析系统 v5.0 - 大盘走势权重版</h1>
            <div class="time-info">
                股票池范围：30只波段股票 | 数据更新：<span id="updateTime">--</span>
                <span id="updateStatus" style="margin-left:10px;color:#f59e0b"></span>
            </div>
            <div>
                <button class="btn" onclick="refreshData()">🔄 刷新数据</button>
                <button class="btn btn-success" onclick="forceUpdate()">⚡ 立即更新</button>
                <button class="btn btn-info" onclick="showReport()">📋 查看报告</button>
                <button class="btn" onclick="exportHoldings()">💾 导出持仓</button>
            </div>
        </div>
        
        <!-- 持仓录入面板 -->
        <div class="input-panel">
            <div class="input-header">📝 持仓数据录入（仅限股票池30只）</div>
            <div class="input-form">
                <div class="input-group">
                    <label class="input-label">股票代码（自动映射名称）</label>
                    <select id="stockCode" class="input-field">
                        <option value="">-- 选择股票 --</option>
                        <option value="605196.SH">华通线缆 (605196.SH)</option>
                        <option value="688028.SH">沃尔德 (688028.SH)</option>
                        <option value="688195.SH">芯源微 (688195.SH)</option>
                        <option value="688233.SH">铂力特 (688233.SH)</option>
                        <option value="688519.SH">天奈科技 (688519.SH)</option>
                        <option value="002353.SZ">杰瑞股份 (002353.SZ)</option>
                        <option value="002384.SZ">东山精密 (002384.SZ)</option>
                        <option value="600183.SH">生益科技 (600183.SH)</option>
                        <option value="603876.SH">鼎胜新材 (603876.SH)</option>
                        <option value="603986.SH">兆易创新 (603986.SH)</option>
                        <option value="688416.SH">恒玄科技 (688416.SH)</option>
                        <option value="688521.SH">芯原股份 (688521.SH)</option>
                        <option value="688676.SH">金迪克 (688676.SH)</option>
                        <option value="300136.SZ">信维通导 (300136.SZ)</option>
                        <option value="603225.SH">新凤鸣 (603225.SH)</option>
                        <option value="688308.SH">拓荆科技 (688308.SH)</option>
                        <option value="688388.SH">嘉元科技 (688388.SH)</option>
                        <option value="688556.SH">高测股份 (688556.SH)</option>
                        <option value="600118.SH">中国卫星 (600118.SH)</option>
                        <option value="601231.SH">环旭电子 (601231.SH)</option>
                        <option value="688658.SH">悦康药业 (688658.SH)</option>
                        <option value="688668.SH">鼎通股份 (688668.SH)</option>
                        <option value="688788.SH">科思科技 (688788.SH)</option>
                        <option value="002202.SZ">金风科技 (002202.SZ)</option>
                        <option value="002916.SZ">深南电路 (002916.SZ)</option>
                        <option value="300604.SZ">长川科技 (300604.SZ)</option>
                        <option value="603228.SH">景旺电子 (603228.SH)</option>
                        <option value="688698.SH">博众精工 (688698.SH)</option>
                        <option value="002460.SZ">赣锋锂业 (002460.SZ)</option>
                        <option value="300476.SZ">胜宏科技 (300476.SZ)</option>
                    </select>
                </div>
                <div class="input-group">
                    <label class="input-label">持仓数量（股）</label>
                    <input type="number" id="shares" class="input-field" placeholder="如：1000" min="1" step="100">
                </div>
                <div class="input-group">
                    <label class="input-label">持仓成本（元）</label>
                    <input type="number" id="buyPrice" class="input-field" placeholder="如：45.20" min="0.01" step="0.01">
                </div>
                <div class="input-group">
                    <label class="input-label">买入日期</label>
                    <input type="date" id="buyDate" class="input-field" value="2026-04-20">
                </div>
                <div class="input-group">
                    <button class="btn btn-success btn-sm" onclick="addHolding()">+ 添加持仓</button>
                </div>
            </div>
            <div class="holdings-list" id="holdingsList"></div>
        </div>
        
        <!-- 统计面板 -->
        <div class="stats-panel">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-value" id="holdCount">0</div>
                    <div class="stat-label">持仓数量</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="totalCost">0</div>
                    <div class="stat-label">总成本(元)</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="totalValue">0</div>
                    <div class="stat-label">当前市值</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="totalProfit">0</div>
                    <div class="stat-label">持仓盈亏</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="profitRate">0%</div>
                    <div class="stat-label">收益率</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="avgScore">--</div>
                    <div class="stat-label">平均评分</div>
                </div>
            </div>
        </div>
        
        <!-- 四栏分析面板 -->
        <div class="analysis-grid">
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">🟢 买入推荐</span>
                    <span class="panel-count" id="buyCount">0只</span>
                </div>
                <div class="stock-list" id="buyList"></div>
            </div>
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">🔵 持仓指导</span>
                    <span class="panel-count" id="holdCount2">0只</span>
                </div>
                <div class="stock-list" id="holdList"></div>
            </div>
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">🔴 卖出建议</span>
                    <span class="panel-count" id="sellCount">0只</span>
                </div>
                <div class="stock-list" id="sellList"></div>
            </div>
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">🟡 观望池</span>
                    <span class="panel-count" id="watchCount">0只</span>
                </div>
                <div class="stock-list" id="watchList"></div>
            </div>
        </div>
        
        <!-- 大盘信息面板 -->
        <div class="market-panel">
            <div class="market-header">📊 大盘走势信息</div>
            <div class="market-grid" id="marketGrid">
                <div class="market-card">
                    <div class="market-card-label">市场状态</div>
                    <div class="market-card-value" id="marketStatus">--</div>
                </div>
                <div class="market-card">
                    <div class="market-card-label">5日涨跌</div>
                    <div class="market-card-value" id="marketPct">--</div>
                </div>
                <div class="market-card">
                    <div class="market-card-label">调整因子</div>
                    <div class="market-card-value" id="marketFactor">--</div>
                </div>
                <div class="market-card">
                    <div class="market-card-label">买入阈值</div>
                    <div class="market-card-value" id="marketThreshold">--</div>
                </div>
            </div>
            <div class="market-chart">
                <div class="market-chart-title">沪深300最近5日走势</div>
                <div id="marketChartContent"></div>
            </div>
            <div class="market-adjust-examples">
                <div class="market-adjust-title">评分调整示例</div>
                <div id="adjustExamples"></div>
            </div>
        </div>
    </div>
    
    <!-- 弹窗 -->
    <div class="modal" id="reportModal">
        <div class="modal-content" style="position:relative;">
            <span class="modal-close" onclick="closeModal()">×</span>
            <div class="modal-header" id="modalTitle">股票详细报告</div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
    
    <script>
        // 股票名称映射
        const STOCK_NAMES = {
            '605196.SH': '华通线缆', '688028.SH': '沃尔德', '688195.SH': '芯源微',
            '688233.SH': '铂力特', '688519.SH': '天奈科技', '002353.SZ': '杰瑞股份',
            '002384.SZ': '东山精密', '600183.SH': '生益科技', '603876.SH': '鼎胜新材',
            '603986.SH': '兆易创新', '688416.SH': '恒玄科技', '688521.SH': '芯原股份',
            '688676.SH': '金迪克', '300136.SZ': '信维通导', '603225.SH': '新凤鸣',
            '688308.SH': '拓荆科技', '688388.SH': '嘉元科技', '688556.SH': '高测股份',
            '600118.SH': '中国卫星', '601231.SH': '环旭电子', '688658.SH': '悦康药业',
            '688668.SH': '鼎通股份', '688788.SH': '科思科技', '002202.SZ': '金风科技',
            '002916.SZ': '深南电路', '300604.SZ': '长川科技', '603228.SH': '景旺电子',
            '688698.SH': '博众精工', '002460.SZ': '赣锋锂业', '300476.SZ': '胜宏科技',
        };
        
        // 持仓数据
        let holdings = [];
        let analysisData = null;
        
        // 初始化
        function init() {
            try {
                holdings = JSON.parse(localStorage.getItem('stockHoldings') || '[]');
            } catch(e) { holdings = []; }
            renderHoldings();
            loadData();
            setInterval(loadData, 300000);
            
            // 监听更新状态
            if (window.electronAPI) {
                window.electronAPI.onUpdateStatus((status) => {
                    document.getElementById('updateStatus').textContent = status;
                });
                window.electronAPI.onDataUpdated(() => {
                    loadData();
                    document.getElementById('updateStatus').textContent = '';
                });
            }
        }
        
        // 添加持仓
        function addHolding() {
            const code = document.getElementById('stockCode').value;
            const shares = parseInt(document.getElementById('shares').value) || 0;
            const buyPrice = parseFloat(document.getElementById('buyPrice').value) || 0;
            const buyDate = document.getElementById('buyDate').value;
            
            if (!code) { alert('请选择股票代码！'); return; }
            if (shares <= 0) { alert('请输入正确的持仓数量！'); return; }
            if (buyPrice <= 0) { alert('请输入正确的持仓成本！'); return; }
            
            const existing = holdings.find(h => h.code === code);
            if (existing) {
                existing.shares = shares;
                existing.buyPrice = buyPrice;
                existing.buyDate = buyDate;
            } else {
                holdings.push({ 
                    code, 
                    name: STOCK_NAMES[code] || code, 
                    shares, 
                    buyPrice, 
                    buyDate 
                });
            }
            
            localStorage.setItem('stockHoldings', JSON.stringify(holdings));
            
            document.getElementById('stockCode').value = '';
            document.getElementById('shares').value = '';
            document.getElementById('buyPrice').value = '';
            
            renderHoldings();
            if (analysisData) updateHoldingsAnalysis(analysisData);
            
            alert('持仓已添加：' + STOCK_NAMES[code] + ' ' + shares + '股');
        }
        
        // 删除持仓
        function deleteHolding(code) {
            holdings = holdings.filter(h => h.code !== code);
            localStorage.setItem('stockHoldings', JSON.stringify(holdings));
            renderHoldings();
            if (analysisData) updateHoldingsAnalysis(analysisData);
        }
        
        // 渲染持仓列表
        function renderHoldings() {
            const container = document.getElementById('holdingsList');
            
            if (holdings.length === 0) {
                container.innerHTML = '<div style="color:#888;text-align:center;padding:15px;grid-column:1/-1;">暂无持仓数据，请在上方添加</div>';
                document.getElementById('holdCount').textContent = '0';
                document.getElementById('totalCost').textContent = '0';
                return;
            }
            
            container.innerHTML = holdings.map(h => `
                <div class="holding-card">
                    <div class="holding-header">
                        <span class="holding-name">${h.name}</span>
                        <button class="btn btn-danger btn-sm" onclick="deleteHolding('${h.code}')">删除</button>
                    </div>
                    <div class="holding-details">
                        <div class="detail-item"><div class="detail-label">代码</div><div class="detail-value">${h.code}</div></div>
                        <div class="detail-item"><div class="detail-label">数量</div><div class="detail-value">${h.shares}股</div></div>
                        <div class="detail-item"><div class="detail-label">成本</div><div class="detail-value">${h.buyPrice.toFixed(2)}元</div></div>
                        <div class="detail-item"><div class="detail-label">买入日期</div><div class="detail-value">${h.buyDate}</div></div>
                    </div>
                    <div class="holding-advice" id="advice_${h.code.replace('.','_')}">等待分析数据...</div>
                </div>
            `).join('');
            
            document.getElementById('holdCount').textContent = holdings.length;
            document.getElementById('totalCost').textContent = Math.round(holdings.reduce((a,b) => a + b.shares * b.buyPrice, 0));
        }
        
        // 加载分析数据
        function loadData() {
            fetch('result.json?t=' + Date.now())
                .then(r => {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(data => {
                    analysisData = data;
                    displayAnalysis(data);
                    updateHoldingsAnalysis(data);
                    displayMarket(data);
                    document.getElementById('updateTime').textContent = data.update_time || '--';
                })
                .catch(e => {
                    document.getElementById('buyList').innerHTML = '<div style="color:#888;text-align:center;padding:20px;">请先运行分析：python analyzer_v4.py</div>';
                });
        }
        
        // 更新持仓分析
        function updateHoldingsAnalysis(data) {
            if (!data || !data.stocks) return;
            
            let totalValue = 0, totalProfit = 0, scores = [];
            const totalCost = holdings.reduce((a,b) => a + b.shares * b.buyPrice, 0);
            
            holdings.forEach(h => {
                const analysis = data.stocks.find(s => s.code === h.code);
                if (analysis) {
                    const currentPrice = analysis.close;
                    const profit = (currentPrice - h.buyPrice) / h.buyPrice * 100;
                    const holdDays = Math.floor((new Date() - new Date(h.buyDate)) / 86400000);
                    
                    totalValue += currentPrice * h.shares;
                    totalProfit += (currentPrice - h.buyPrice) * h.shares;
                    scores.push(analysis.score);
                    
                    const adviceId = 'advice_' + h.code.replace('.','_');
                    const adviceEl = document.getElementById(adviceId);
                    if (adviceEl) {
                        const profitClass = profit >= 15 ? 'advice-sell' : profit <= -10 ? 'advice-sell' : 'advice-hold';
                        adviceEl.className = 'holding-advice ' + profitClass;
                        adviceEl.innerHTML = `
                            <div>现价: <strong>${currentPrice.toFixed(2)}元</strong> | 盈亏: <strong style="color:${profit>=0?'#10b981':'#ef4444'}">${profit.toFixed(1)}%</strong></div>
                            <div>评分: ${analysis.score}分 | 持仓: ${holdDays}天</div>
                            <div style="margin-top:4px;font-weight:bold;">${getHoldingAdvice(profit, analysis.score, holdDays)}</div>
                        `;
                    }
                }
            });
            
            document.getElementById('totalValue').textContent = Math.round(totalValue);
            document.getElementById('totalProfit').textContent = Math.round(totalProfit);
            document.getElementById('profitRate').textContent = totalCost > 0 ? ((totalValue - totalCost) / totalCost * 100).toFixed(1) + '%' : '0%';
            document.getElementById('avgScore').textContent = scores.length > 0 ? Math.round(scores.reduce((a,b) => a+b) / scores.length) : '--';
            document.getElementById('holdCount2').textContent = holdings.length;
            
            // 更新盈亏颜色
            const profitEl = document.getElementById('totalProfit');
            profitEl.className = totalProfit >= 0 ? 'stat-value' : 'stat-value negative';
        }
        
        // 显示分析数据
        function displayAnalysis(data) {
            const stocks = data.stocks || [];
            const holdingCodes = holdings.map(h => h.code);
            const threshold = data.market?.threshold || 60;  // 从market获取买入阈值
            
            // 分类（使用adjusted_score，不排除持仓股）
            const buyStocks = stocks.filter(s => (s.adjusted_score || s.score) >= threshold).sort((a,b) => (b.adjusted_score || b.score) - (a.adjusted_score || a.score));
            const sellStocks = stocks.filter(s => (s.adjusted_score || s.score) < 15).sort((a,b) => (a.adjusted_score || a.score) - (b.adjusted_score || b.score));
            const watchStocks = stocks.filter(s => (s.adjusted_score || s.score) >= 15 && (s.adjusted_score || s.score) < threshold);
            const holdStocks = stocks.filter(s => holdingCodes.includes(s.code));
            
            // 买入推荐
            document.getElementById('buyCount').textContent = buyStocks.length + '只';
            document.getElementById('buyList').innerHTML = buyStocks.length > 0 ? buyStocks.map(s => `
                <div class="stock-card">
                    <div class="stock-header">
                        <div><span class="stock-name">${s.name}</span><span class="stock-code">${s.code}</span></div>
                        <span class="stock-score score-high">${s.adjusted_score || s.score}</span>
                    </div>
                    <div class="stock-price-info">
                        <span class="price-item">现价: <strong>${s.close.toFixed(2)}元</strong></span>
                        <span class="price-item">建议买入: <strong class="price-buy">${s.buy_price.toFixed(2)}元</strong></span>
                    </div>
                    <div class="stock-price-info">
                        <span class="price-item">目标卖出: <strong class="price-sell">${s.sell_price.toFixed(2)}元</strong></span>
                        <span class="price-item">止损价: <strong style="color:#ef4444">${s.stop_price.toFixed(2)}元</strong></span>
                    </div>
                    <div class="stock-info">
                        <span>RSI6: ${s.rsi6 || '--'}</span>
                        <span>涨幅概率: ${s.score}%</span>
                    </div>
                    <div class="stock-advice advice-buy">${s.advice || getBuyAdvice(s)}</div>
                    <div class="stock-actions">
                        <button class="btn btn-sm btn-info" onclick="showStockReport('${s.code}')">查看报告</button>
                    </div>
                </div>
            `).join('') : '<div style="color:#888;text-align:center;padding:20px;">暂无买入推荐</div>';
            
            // 持仓指导
            document.getElementById('holdList').innerHTML = holdStocks.length > 0 ? holdStocks.map(s => {
                const h = holdings.find(h => h.code === s.code);
                const profit = h ? (s.close - h.buyPrice) / h.buyPrice * 100 : 0;
                const targetSell = h ? (h.buyPrice * 1.25).toFixed(2) : s.sell_price.toFixed(2); // 目标止盈价
                const stopLoss = h ? (h.buyPrice * 0.90).toFixed(2) : s.stop_price.toFixed(2); // 止损价
                return `
                    <div class="stock-card">
                        <div class="stock-header">
                            <div><span class="stock-name">${s.name}</span><span class="stock-code">${s.code}</span></div>
                            <span class="stock-score ${profit>=0?'score-high':'score-low'}">${profit.toFixed(1)}%</span>
                        </div>
                        <div class="stock-price-info">
                            <span class="price-item">成本: <strong>${h ? h.buyPrice.toFixed(2) : '--'}元</strong></span>
                            <span class="price-item">现价: <strong class="${profit>=0?'price-buy':'price-sell'}">${s.close.toFixed(2)}元</strong></span>
                        </div>
                        <div class="stock-price-info">
                            <span class="price-item">目标卖出: <strong class="price-sell">${targetSell}元</strong></span>
                            <span class="price-item">止损价: <strong style="color:#ef4444">${stopLoss}元</strong></span>
                        </div>
                        <div class="stock-info">
                            <span>评分: ${s.score}分</span>
                            <span>持仓: ${h ? h.shares : '--'}股</span>
                        </div>
                        <div class="stock-advice ${profit>=25?'advice-sell':profit<=-10?'advice-sell':'advice-hold'}">${getHoldingAdvice(profit, s.score, 0)}</div>
                        <div class="stock-actions">
                            <button class="btn btn-sm btn-info" onclick="showStockReport('${s.code}')">查看报告</button>
                        </div>
                    </div>
                `;
            }).join('') : '<div style="color:#888;text-align:center;padding:20px;">请添加持仓数据</div>';
            
            // 卖出建议
            document.getElementById('sellCount').textContent = sellStocks.length + '只';
            document.getElementById('sellList').innerHTML = sellStocks.length > 0 ? sellStocks.map(s => `
                <div class="stock-card">
                    <div class="stock-header">
                        <div><span class="stock-name">${s.name}</span><span class="stock-code">${s.code}</span></div>
                        <span class="stock-score score-low">${s.adjusted_score || s.score}</span>
                    </div>
                    <div class="stock-price-info">
                        <span class="price-item">现价: <strong class="price-sell">${s.close.toFixed(2)}元</strong></span>
                        <span class="price-item">建议卖出: <strong class="price-sell">${s.close.toFixed(2)}元</strong></span>
                    </div>
                    <div class="stock-price-info">
                        <span class="price-item">跌幅概率: ${100-s.score}%</span>
                        <span class="price-item">止损价: <strong style="color:#ef4444">${s.stop_price ? s.stop_price.toFixed(2) : (s.close*0.9).toFixed(2)}元</strong></span>
                    </div>
                    <div class="stock-advice advice-sell">${s.advice || getSellAdvice(s)}</div>
                    <div class="stock-actions">
                        <button class="btn btn-sm btn-info" onclick="showStockReport('${s.code}')">查看报告</button>
                    </div>
                </div>
            `).join('') : '<div style="color:#888;text-align:center;padding:20px;">暂无卖出建议</div>';
            
            // 观望池
            document.getElementById('watchCount').textContent = watchStocks.length + '只';
            document.getElementById('watchList').innerHTML = watchStocks.length > 0 ? watchStocks.map(s => `
                <div class="stock-card">
                    <div class="stock-header">
                        <div><span class="stock-name">${s.name}</span><span class="stock-code">${s.code}</span></div>
                        <span class="stock-score score-medium">${s.adjusted_score || s.score}</span>
                    </div>
                    <div class="stock-price-info">
                        <span class="price-item">现价: ${s.close.toFixed(2)}元</span>
                    </div>
                    <div class="stock-advice advice-watch">${s.advice || '观望，等待明确信号'}</div>
                </div>
            `).join('') : '<div style="color:#888;text-align:center;padding:20px;">暂无观望股票</div>';
        }
        
        
        // 显示大盘信息
        function displayMarket(data) {
            const market = data.market || {};
            
            // 显示市场状态
            const statusEl = document.getElementById('marketStatus');
            const pctEl = document.getElementById('marketPct');
            const factorEl = document.getElementById('marketFactor');
            const thresholdEl = document.getElementById('marketThreshold');
            
            if (statusEl) {
                const status = market.status || '震荡市场';
                statusEl.textContent = status;
                statusEl.className = 'market-card-value ' + 
                    (status.includes('强') ? 'market-strong' : status.includes('弱') ? 'market-weak' : 'market-neutral');
            }
            
            if (pctEl) {
                const pct = market.pct_5d || 0;
                pctEl.textContent = pct.toFixed(2) + '%';
                pctEl.className = 'market-card-value ' + 
                    (pct >= 1 ? 'market-strong' : pct <= -1 ? 'market-weak' : 'market-neutral');
            }
            
            if (factorEl) {
                const factor = market.factor || 1.0;
                factorEl.textContent = factor.toFixed(2);
                factorEl.className = 'market-card-value ' + 
                    (factor > 1 ? 'market-strong' : factor < 1 ? 'market-weak' : 'market-neutral');
            }
            
            if (thresholdEl) {
                thresholdEl.textContent = (market.threshold || 60) + '分';
                thresholdEl.className = 'market-card-value market-neutral';
            }
            
            // 显示最近5日走势
            const chartEl = document.getElementById('marketChartContent');
            if (chartEl && market.recent_5d) {
                chartEl.innerHTML = market.recent_5d.map(r => {
                    const pctClass = r.pct_chg >= 0 ? 'market-strong' : 'market-weak';
                    return `<div class="market-chart-row">
                        <span class="market-chart-date">${r.date}</span>
                        <span class="market-chart-close">${r.close.toFixed(2)}</span>
                        <span class="market-chart-pct ${pctClass}">${r.pct_chg.toFixed(2)}%</span>
                    </div>`;
                }).join('');
            }
            
            // 显示评分调整示例
            const adjustEl = document.getElementById('adjustExamples');
            if (adjustEl && data.stocks) {
                const samples = data.stocks.slice(0, 5);
                adjustEl.innerHTML = samples.map(s => {
                    const adjScore = s.adjusted_score || s.score;  // 容错：无adjusted_score时用原score
                    const change = adjScore - s.score;
                    const changeClass = change > 0 ? 'market-strong' : change < 0 ? 'market-weak' : 'market-neutral';
                    return `<div class="market-adjust-row">
                        ${s.name}: 原评分${s.score} → 调整后<span class="${changeClass}">${s.adjusted_score}</span> (${change >= 0 ? '+' : ''}${change})
                    </div>`;
                }).join('');
            }
        }

// 显示详细报告
        function displayReport(data) {
            const stats = data.statistics || {};
            const market = data.market_analysis || '';
            
            document.getElementById('reportContent').innerHTML = `
                <div class="report-card">
                    <div class="report-title">今日策略</div>
                    <div class="report-detail">
                        买入推荐: ${stats.buy_count || 0}只<br>
                        卖出建议: ${stats.sell_count || 0}只<br>
                        持仓监控: ${stats.holding_count || 0}只
                    </div>
                </div>
                <div class="report-card">
                    <div class="report-title">持仓盈亏</div>
                    <div class="report-detail">
                        总成本: ${(data.holdings_stats?.total_cost || 0).toFixed(0)}元<br>
                        当前市值: ${(data.holdings_stats?.total_value || 0).toFixed(0)}元<br>
                        收益率: ${(data.holdings_stats?.profit_rate || 0).toFixed(1)}%
                    </div>
                </div>
                <div class="report-card">
                    <div class="report-title">市场分析</div>
                    <div class="report-detail">${market || '震荡市场，信号中性'}</div>
                </div>
                <div class="report-card">
                    <div class="report-title">风险提示</div>
                    <div class="report-detail">
                        止损线: -10%<br>
                        止盈线: +25%<br>
                        严格执行纪律
                    </div>
                </div>
                <div class="report-card">
                    <div class="report-title">操作建议</div>
                    <div class="report-detail">
                        高评分(≥80): 优先配置<br>
                        中评分(60-79): 分批建仓<br>
                        低评分(<15): 及时止损
                    </div>
                </div>
            `;
        }
        
        // 买入建议生成
        function getBuyAdvice(s) {
            if (s.score >= 80) return `强烈推荐买入！评分${s.score}分。建议优先配置15-20%仓位。`;
            if (s.score >= 70) return `推荐买入。评分${s.score}分。建议分批建仓，首次10%。`;
            return `可考虑买入。评分${s.score}分。建议T+1策略。`;
        }
        
        // 卖出建议生成
        function getSellAdvice(s) {
            return `建议卖出！评分仅${s.score}分，跌幅概率${100-s.score}%。`;
        }
        
        // 持仓建议生成
        function getHoldingAdvice(profit, score, days) {
            if (profit >= 25) return '✅ 已达止盈线(25%)，建议分批卖出锁定收益';
            if (profit >= 15) return '盈利可观，建议部分止盈30-50%';
            if (profit >= 5) return '小幅盈利，可继续持有';
            if (profit >= -5) return '轻微亏损，继续观察';
            if (profit >= -10) return '⚠️ 接近止损线(-10%)，密切关注';
            return '🔴 触发止损线，建议果断卖出';
        }
        
        // 显示股票报告弹窗
        function showStockReport(code) {
            if (!analysisData) return;
            const stock = analysisData.stocks.find(s => s.code === code);
            if (!stock) return;
            
            const h = holdings.find(h => h.code === code);
            const profit = h ? ((stock.close - h.buyPrice) / h.buyPrice * 100).toFixed(1) : '--';
            
            document.getElementById('modalTitle').textContent = stock.name + ' 详细报告';
            document.getElementById('modalBody').innerHTML = `
                <div style="margin-bottom:15px;">
                    <strong>基本信息</strong><br>
                    代码: ${stock.code}<br>
                    现价: ${stock.close.toFixed(2)}元<br>
                    涨跌幅: ${stock.pct_chg.toFixed(2)}%<br>
                    评分: ${stock.score}分<br>
                </div>
                <div style="margin-bottom:15px;">
                    <strong>技术指标</strong><br>
                    RSI6: ${stock.rsi6 || '--'}<br>
                    MACD: ${stock.macd || '--'}<br>
                    成交量: ${(stock.volume/10000).toFixed(0)}万<br>
                </div>
                ${h ? `
                <div style="margin-bottom:15px;">
                    <strong>持仓信息</strong><br>
                    成本: ${h.buyPrice.toFixed(2)}元<br>
                    数量: ${h.shares}股<br>
                    盈亏: ${profit}%<br>
                    持仓天数: ${Math.floor((new Date()-new Date(h.buyDate))/86400000)}天<br>
                </div>
                ` : ''}
                <div>
                    <strong>操作建议</strong><br>
                    ${stock.advice || (stock.score >= 60 ? getBuyAdvice(stock) : getSellAdvice(stock))}
                </div>
            `;
            
            document.getElementById('reportModal').classList.add('show');
        }
        
        // 显示整体报告
        function showReport() {
            if (!analysisData) {
                alert('请先运行分析获取数据');
                return;
            }
            
            document.getElementById('modalTitle').textContent = '整体分析报告';
            document.getElementById('modalBody').innerHTML = `
                <div style="margin-bottom:15px;">
                    <strong>股票池概况</strong><br>
                    分析股票: ${analysisData.statistics?.total || 30}只<br>
                    买入推荐: ${analysisData.statistics?.buy_count || 0}只<br>
                    卖出建议: ${analysisData.statistics?.sell_count || 0}只<br>
                    观望股票: ${analysisData.statistics?.watch_count || 0}只<br>
                </div>
                <div style="margin-bottom:15px;">
                    <strong>持仓概况</strong><br>
                    持仓数量: ${holdings.length}只<br>
                    总成本: ${(analysisData.holdings_stats?.total_cost || 0).toFixed(0)}元<br>
                    当前市值: ${(analysisData.holdings_stats?.total_value || 0).toFixed(0)}元<br>
                    收益率: ${(analysisData.holdings_stats?.profit_rate || 0).toFixed(1)}%<br>
                </div>
                <div>
                    <strong>市场分析</strong><br>
                    ${analysisData.market_analysis || '震荡市场'}
                </div>
            `;
            
            document.getElementById('reportModal').classList.add('show');
        }
        
        // 关闭弹窗
        function closeModal() {
            document.getElementById('reportModal').classList.remove('show');
        }
        
        // 刷新数据（仅读取JSON）
        function refreshData() { loadData(); }
        
        // 立即更新（数据更新+分析）
        function forceUpdate() {
            document.getElementById('updateStatus').textContent = '正在更新...';
            if (window.electronAPI) {
                window.electronAPI.refreshData();
            } else {
                alert('请在命令行运行：python analyzer_v4.py');
            }
        }
        
        // 导出持仓
        function exportHoldings() {
            const data = JSON.stringify(holdings, null, 2);
            const blob = new Blob([data], {type: 'application/json'});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'holdings_' + new Date().toISOString().slice(0,10) + '.json';
            a.click();
        }
        
        // 点击弹窗外部关闭
        document.getElementById('reportModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
        
        // 初始化
        init();
    </script>
</body>
</html>